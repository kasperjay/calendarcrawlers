# Example Environment Configuration
# Copy this file to .env and update with your values

# Actor Type: generic or example
ACTOR_TYPE=generic

# Venue Information
VENUE_NAME=Example Venue
VENUE_URL=https://example.com/events

# CSS Selectors (optional - defaults will be used if not specified)
EVENT_SELECTOR=.event-item
TITLE_SELECTOR=.event-title
DATE_SELECTOR=.event-date
LINK_SELECTOR=a

# Apify Configuration (for deployment)
# APIFY_TOKEN=your_token_here
